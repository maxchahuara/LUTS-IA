[Unit]
Description=MAX restricted voice ingress
After=max.service
Wants=max.service
StartLimitIntervalSec=0

[Service]
WorkingDirectory=%h/projects/LUTS-IA
ExecStart=%h/.local/share/max/venv/bin/uvicorn max_runtime.edge:app --host 127.0.0.1 --port 8788 --no-access-log
Restart=always
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
