[Unit]
Description=MAX Alexa and Codex runtime
After=network-online.target openclaw-gateway.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/projects/LUTS-IA
Environment=PATH=%h/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
Environment=MAX_CONFIG=%h/.config/max/config.json
ExecStart=%h/.local/share/max/venv/bin/uvicorn max_runtime.app:create_app --factory --host 127.0.0.1 --port 8787 --no-access-log
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/max %h/.config/max %h/.openclaw
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TimeoutStopSec=15

[Install]
WantedBy=default.target
